// FamilyGuard — esquema de base de datos
// Diseño propio, independiente de cualquier app de terceros.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parent {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  children     ChildDevice[]
  geofences    Geofence[]
  pairingCodes PairingCode[]
  pushTokens   PushToken[]
  adults       Adult[]
  adultInvites AdultInvite[]
}

// Otro adulto de la misma familia (la madre, por ejemplo): entra con su propio email y contraseña
// y ve a los mismos hijos que la cuenta principal. Todo el sistema sigue filtrando por Parent.id.
model Adult {
  id           String   @id @default(uuid())
  parent       Parent   @relation(fields: [parentId], references: [id])
  parentId     String
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Invitación de un solo uso y corta duración para sumar un adulto.
model AdultInvite {
  id        String    @id @default(uuid())
  code      String    @unique
  parent    Parent    @relation(fields: [parentId], references: [id])
  parentId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PairingCode {
  id        String    @id @default(uuid())
  code      String    @unique // código corto de 6 dígitos que se escribe en la app del chico
  parent    Parent    @relation(fields: [parentId], references: [id])
  parentId  String
  childName String // nombre que el padre le puso al perfil antes de emparejar
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ChildDevice {
  id           String   @id @default(uuid())
  parent       Parent   @relation(fields: [parentId], references: [id])
  parentId     String
  name         String
  deviceModel  String?
  deviceToken  String   @unique // JWT de larga duración que usa la app del chico para autenticarse
  lastSeenAt   DateTime?
  batteryLevel Int?
  createdAt    DateTime @default(now())
  // Cuándo se avisó por última vez "dejó de reportar". Se limpia apenas
  // vuelve a llegar un ping, así el próximo silencio avisa de nuevo en vez
  // de quedar mudo para siempre después del primer aviso.
  silenceAlertSentAt DateTime?

  // Latido: el teléfono avisa "estoy vivo" cada ~15 min aunque no consiga GPS,
  // así el padre distingue "app activa pero sin ubicación" de "app detenida".
  lastHeartbeatAt DateTime?
  // Salud del teléfono, informada por la app del hijo (null = todavía no informó).
  healthBatteryUnrestricted Boolean? // false = el fabricante puede matar el servicio (típico en Motorola)
  healthBackgroundLocation  Boolean? // permiso de ubicación "todo el tiempo"
  healthLocationEnabled     Boolean? // el GPS del sistema está prendido
  healthAppVersion          String?
  healthAt                  DateTime?

  locationPings   LocationPing[]
  geofences       Geofence[]
  geofenceEvents  GeofenceEvent[]
  appUsageRecords AppUsageRecord[]
  sosAlerts       SosAlert[]
  blockedApps     BlockedApp[]
  tasks           Task[]
  feedEvents      FeedEvent[]
}

// Misión que el padre le asigna al hijo/a: la hace, (opcionalmente) manda una foto
// como prueba, y el padre la aprueba. Si se repite, al aprobarla nace la siguiente.
model Task {
  id            String      @id @default(uuid())
  parentId      String
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  title         String
  reward        String      @default("")
  requiresPhoto Boolean     @default(false)
  repeat        String      @default("none") // "none" | "weekly" | "monthly"
  dueDate       DateTime
  status        String      @default("open") // "open" | "waiting" (esperando aprobación) | "confirmed"
  hasPhoto      Boolean     @default(false)
  // JPEG/PNG chico en base64 (el teléfono lo reduce antes de mandarlo). Se pide aparte
  // (GET /tasks/:id/photo) para que la lista no cargue imágenes de más.
  photoBase64   String?
  doneAt        DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([childDeviceId, status])
  @@index([parentId, status])
}

// Novedades para el padre: "llegó bien", "va en camino", "terminó una misión"…
model FeedEvent {
  id            String      @id @default(uuid())
  parentId      String
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  type          String // "checkin_arrived" | "checkin_on_my_way" | "task_done" | "task_confirmed"
  title         String
  body          String      @default("")
  createdAt     DateTime    @default(now())

  @@index([parentId, createdAt])
}

model LocationPing {
  id            String      @id @default(uuid())
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  lat           Float
  lng           Float
  accuracyM     Float?
  speedMs       Float? // velocidad instantánea en m/s que reporta el GPS; null si el dispositivo no la informó
  // "walking" | "running" | "bicycle" | "vehicle" | "still"; null si no hubo
  // una detección reciente con confianza suficiente (API de Google Play
  // Services, no una medición exacta).
  activityType  String?
  recordedAt    DateTime    @default(now())

  @@index([childDeviceId, recordedAt])
}

model Geofence {
  id            String      @id @default(uuid())
  parent        Parent      @relation(fields: [parentId], references: [id])
  parentId      String
  childDevice   ChildDevice? @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String? // null = aplica a todos los hijos de este padre
  name          String
  lat           Float
  lng           Float
  radiusMeters  Float
  createdAt     DateTime    @default(now())

  events GeofenceEvent[]
}

model GeofenceEvent {
  id            String      @id @default(uuid())
  geofence      Geofence    @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  geofenceId    String
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  type          String // "ENTER" | "EXIT"
  occurredAt    DateTime    @default(now())
}

model AppUsageRecord {
  id            String      @id @default(uuid())
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  packageName   String
  appName       String
  date          DateTime // día calendario (medianoche UTC) al que corresponde el acumulado
  usageMinutes  Int

  @@unique([childDeviceId, packageName, date])
}

model BlockedApp {
  id            String      @id @default(uuid())
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  packageName   String
  dailyLimitMin Int? // null = bloqueada por completo

  @@unique([childDeviceId, packageName])
}

model SosAlert {
  id            String      @id @default(uuid())
  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  childDeviceId String
  lat           Float
  lng           Float
  message       String?
  // Mensaje de voz corto (10-15s) que el hijo graba a propósito al mandar la
  // alerta — decisión suya, no algo que el padre activa a distancia. Se
  // guarda en base64 directo en la fila: son clips cortos, no vale la pena
  // un bucket de almacenamiento aparte para este volumen.
  audioClipBase64 String?
  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?
}

model PushToken {
  id        String   @id @default(uuid())
  parent    Parent   @relation(fields: [parentId], references: [id])
  parentId  String
  token     String   @unique
  platform  String // "android"
  createdAt DateTime @default(now())
}
