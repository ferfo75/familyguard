<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FamilyGuardParent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/guardian_blue</item>
        <item name="android:windowBackground">@color/mist</item>
    </style>
    <!-- Ventanas de aviso: fondo transparente para que se vea la app de abajo. -->
    <style name="Theme.FamilyGuardParent.Popup" parent="Theme.FamilyGuardParent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
